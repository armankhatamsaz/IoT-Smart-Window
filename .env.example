# Copy this file to .env and fill in the values. .env is ignored by git:
# never commit real tokens or keys to the repository.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# ThingSpeak channel 1 (temperature and humidity): API Keys tab of the channel
THINGSPEAK_CH1_WRITE_KEY=
THINGSPEAK_CH1_READ_KEY=

# ThingSpeak channel 2 (light and window positions)
THINGSPEAK_CH2_WRITE_KEY=
THINGSPEAK_CH2_READ_KEY=
